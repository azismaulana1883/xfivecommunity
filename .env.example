# ========================================================
# XFIVE MEMBER - FRONTEND ENVIRONMENT CONFIGURATION (VUE 3)
# ========================================================

# URL Media Sosial Komunitas
VITE_FB_URL=https://www.facebook.com/xfiveofficial
VITE_IG_URL=https://www.instagram.com/xfive.au

# Password Proteksi Halaman Awal (Portal Site)
VITE_SITE_PASSWORD=your_site_password_here

# Cloudflare Turnstile CAPTCHA (Public Site Key)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Backend API URL
# - Saat 'npm run dev', otomatis membaca .env.development: http://localhost:3000
# - Saat 'npm run build', otomatis membaca .env.production:  https://yuukaa.my.id
VITE_API_URL=http://localhost:3000
