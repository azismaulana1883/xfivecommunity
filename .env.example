# Sosmed Links
VITE_FB_URL=https://www.facebook.com/xfiveofficial
VITE_IG_URL=https://www.instagram.com/xfive.au

# Credentials Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# JWT Secret untuk sesi login admin
JWT_SECRET=your_jwt_secret_key_here

# Password Proteksi Halaman Awal (Portal Site)
VITE_SITE_PASSWORD=your_site_password_here

# Koneksi Database MySQL (Database xfive)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=xfive

# Cloudflare Turnstile CAPTCHA Protection
ENABLE_CLOUDFLARE_PROTECTION=false
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Groq AI API Key (XFIVE AI)
GROQ_API_KEY=your_groq_api_key_here
