{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.yuukaa.my.id/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://api.yuukaa.my.id/uploads/:match*"
    },
    {
      "source": "/sitemap-articles.xml",
      "destination": "https://api.yuukaa.my.id/sitemap-articles.xml"
    },
    {
      "source": "/.netlify/functions/get-members",
      "destination": "https://api.yuukaa.my.id/api/v1/members"
    },
    {
      "source": "/.netlify/functions/login",
      "destination": "https://api.yuukaa.my.id/api/v1/auth/login"
    },
    {
      "source": "/.netlify/functions/logout",
      "destination": "https://api.yuukaa.my.id/api/v1/auth/logout"
    },
    {
      "source": "/.netlify/functions/verify-session",
      "destination": "https://api.yuukaa.my.id/api/v1/auth/verify"
    },
    {
      "source": "/.netlify/functions/verify",
      "destination": "https://api.yuukaa.my.id/api/v1/auth/verify"
    },
    {
      "source": "/.netlify/functions/get-blacklist",
      "destination": "https://api.yuukaa.my.id/api/v1/blacklist"
    },
    {
      "source": "/.netlify/functions/get-faq",
      "destination": "https://api.yuukaa.my.id/api/v1/faqs"
    },
    {
      "source": "/.netlify/functions/get-motm",
      "destination": "https://api.yuukaa.my.id/api/v1/motm"
    },
    {
      "source": "/.netlify/functions/get-gallery",
      "destination": "https://api.yuukaa.my.id/api/v1/gallery"
    },
    {
      "source": "/.netlify/functions/submit-registration",
      "destination": "https://api.yuukaa.my.id/api/v1/registrations"
    },
    {
      "source": "/.netlify/functions/get-captcha",
      "destination": "https://api.yuukaa.my.id/api/v1/captcha"
    },
    {
      "source": "/.netlify/functions/verify-captcha",
      "destination": "https://api.yuukaa.my.id/api/v1/captcha/verify"
    },
    {
      "source": "/.netlify/functions/verify-social",
      "destination": "https://api.yuukaa.my.id/api/v1/social/verify"
    },
    {
      "source": "/.netlify/functions/verify-biometric",
      "destination": "https://api.yuukaa.my.id/api/v1/biometric/verify"
    },
    {
      "source": "/.netlify/functions/upload-biometric",
      "destination": "https://api.yuukaa.my.id/api/v1/biometric/upload"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
